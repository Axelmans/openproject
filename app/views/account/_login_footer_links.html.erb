<%
  show_register = Setting::SelfRegistration.enabled?
  show_lost_password = Setting.lost_password?
%>
<% if show_register || show_lost_password %>
  <div class="login-footer-links">
    <% if show_register %>
      <%= render(Primer::Beta::Link.new(href: account_register_path)) { I18n.t(:label_register) } %>
    <% end %>
    <% if show_register && show_lost_password %>
      <span class="login-footer-links--separator" aria-hidden="true">&middot;</span>
    <% end %>
    <% if show_lost_password %>
      <%= render(Primer::Beta::Link.new(href: account_lost_password_path)) { I18n.t(:label_password_lost) } %>
    <% end %>
  </div>
<% end %>
